# OpenAI (server-side only)
OPENAI_API_KEY=
# optional: org-... id, read automatically by the OpenAI SDK
OPENAI_ORG_ID=
OPENAI_MODEL=gpt-5-mini

# Agent Relay workspace (server-side only)
RELAY_WORKSPACE_KEY=
# Optional: self-hosted Relaycast (`bun run dev:relay`, then create a workspace). Empty uses Agent Relay Cloud.
RELAY_BASE_URL=

# Terse Durable Actors
# Local: leave as-is (terse actor dev on :7100). Hosted: URL printed by `terse deploy`.
TERSE_ACTOR_URL=http://127.0.0.1:7100/v1/projects/local/actors
# Only needed for the hosted actor (Terse app > API keys)
TERSE_API_KEY=
